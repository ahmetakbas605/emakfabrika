# Her fabrika kendi MySQL'ini kendi bünyesinde barındırır — bu dosya yalnızca
# TEK bir fabrika dağıtımının (bu makinedeki test kiracısı) bağlantı bilgisidir.
# Üretimde her fabrika kurulumunun KENDİ .env'i, KENDİ MYSQL_* değerleri olur.

# Migration/DDL yetkisi olan bağlantı (root veya CREATE/ALTER yetkili kullanıcı)
MIGRATE_DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3307/emakfabrika

# Uygulamanın kendi bağlantısı — DDL yetkisi OLMAYAN, yalnızca DML (SELECT/
# INSERT/UPDATE/DELETE) yetkili ayrı bir MySQL kullanıcısı (emakerp'in
# emakerp_app rolüyle AYNI "en az yetki" prensibi).
DATABASE_URL=mysql://emakfabrika:CHANGE_ME@127.0.0.1:3307/emakfabrika
# scripts/migrate.ts'in DDL-yetkisini kaldırıp DML-only'e daraltacağı kullanıcı/DB adı
APP_DB_USER=emakfabrika
APP_DB_NAME=emakfabrika

SESSION_SECRET=CHANGE_ME_32_BYTE_HEX

# GİB e-Fatura (SmartDönüşüm) — emakelektron/emakerp ile AYNI özel entegratör,
# kimlik bilgisi bu fabrikaya özel, ayrı şifrelenmiş olarak saklanır.
EFATURA_ENC_KEY=CHANGE_ME_64_HEX_CHARS

# IT-SECURITY.md §1 — network cihazı/SNMP/agent credential'larını şifreler
# (network_credentials.encrypted_secret) — EFATURA_ENC_KEY'den AYRI anahtar.
IT_CREDENTIALS_ENC_KEY=CHANGE_ME_64_HEX_CHARS

NEXT_PUBLIC_APP_URL=http://localhost:3100

# Faz 18 (AI) — Ticket/Incident özet+öneri asistanı. TAMAMEN OPSİYONEL, ikisi
# de boşsa asistan sessizce "yapılandırılmamış" der, uygulama çökmez
# (emakbilisim/backend/lib/ai-provider.js İLE AYNI desen). GROQ_API_KEY
# varsa önce o kullanılır (ücretsiz katman, console.groq.com, kredi kartı
# gerekmez); yoksa ANTHROPIC_API_KEY'e (Claude, ücretli) düşülür.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=
